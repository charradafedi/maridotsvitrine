v\",null,{\"className\":\"card mt-8 border-ocean-200 bg-ocean-50/60 p-6\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex items-start gap-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex size-9 shrink-0 items-center justify-center rounded-xl bg-white text-ocean-600 ring-1 ring-ocean-100\",\"children\":[\"$\",\"$Le\",null,{\"ref\":\"$undefined\",\"icon\":{\"name\":\"flask-conical\",\"size\":24,\"node\":[[\"path\",{\"d\":\"M14 2v6a2 2 0 0 0 .245.96l5.51 10.08A2 2 0 0 1 18 22H6a2 2 0 0 1-1.755-2.96l5.51-10.08A2 2 0 0 0 10 8V2\",\"key\":\"18mbvz\"}],[\"path\",{\"d\":\"M6.453 15h11.094\",\"key\":\"3shlmq\"}],[\"path\",{\"d\":\"M8.5 2h7\",\"key\":\"csnxdl\"}]]},\"className\":\"size-4.5\"}]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-semibold text-ink\",\"children\":\"International cross-border R&D · Tunisia administrative oversight\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 leading-7 text-ink-muted\",\"children\":\"Maridots is jointly developed and managed with administrative oversight in Tunisia. Everything shown here is an internal research prototype for technical discussion. Nothing is sold, licensed, or made available for operational use through this page. Inquiries reach the international team at info@maridots.com.\"}]]}]]}]}],[\"$\",\"div\",null,{\"className\":\"mt-10 divide-y divide-line-soft border-t border-line-soft\",\"children\":[[\"$\",\"section\",\"Nature of the initiative\",{\"className\":\"py-7 sm:grid sm:grid-cols-3 sm:gap-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-semibold text-ink sm:col-span-1\",\"children\":\"Nature of the initiative\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 leading-7 text-ink-muted sm:col-span-2 sm:mt-0\",\"children\":\"Maridots is an international cross-border technology research initiative in maritime compliance and risk architecture. It is jointly developed and managed with administrative oversight by an international associate based in Tunisia. It is not a local commercial company, a product launch, or a software service for sale. The work consists of internal R&D prototypes built to investigate how compliance, risk, and audit workflows behave when they share a single controlled record.\"}]]}],[\"$\",\"section\",\"Administrative & management oversight\",{\"className\":\"py-7 sm:grid sm:grid-cols-3 sm:gap-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-semibold text-ink sm:col-span-1\",\"children\":\"Administrative & management oversight\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 leading-7 text-ink-muted sm:col-span-2 sm:mt-0\",\"children\":\"Day-to-day administrative and management oversight for the initiative sits with our international associate in Tunisia. All public inquiries, technical evaluation discussions, and pilot feedback are processed by the international team through info@maridots.com. There is no domestic German corporate entity, commercial register entry, VAT identifier, or local provider establishment behind this site.\"}]]}],[\"$\",\"section\",\"What the prototypes are\",{\"className\":\"py-7 sm:grid sm:grid-cols-3 sm:gap-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-semibold text-ink sm:col-span-1\",\"children\":\"What the prototypes are\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 leading-7 text-ink-muted sm:col-span-2 sm:mt-0\",\"children\":\"The material shown here consists of internal research prototypes: an executive dashboard exploring fleet KPIs and AI-assisted prioritisation, an asset and certificate register, crewing with STCW work and rest hours, the risk chain from Snap Hazards through incident reports, CAPA, Bowtie barriers, Fishbone RCA and Management of Change to PSC readiness and Permit to Work, audit and document control including audits captured with limited connectivity, Knowledge & Reference archives, a consultancy bureau workspace, and a data migration hub. They are research artefacts used for technical discussion, not products, and not offered for use, licence, or sale.\"}]]}],\"$L10\",\"$L11\",\"$L12\",\"$L13\",\"$L14\",\"$L15\",\"$L16\",\"$L17\"]}]]}],null,\"$L18\"]}]\na:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L19\",null,{\"children\":\"$L1a\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L1b\",null,{\"children\":[\"$\",\"$1c\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L1d\"}]}]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}]\nc:[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/2ew-m63tr2c--.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n1e:I[97367,[\"/_next/static/chunks/0h2qsuyze9ds1.js\"],\"OutletBoundary\"]\n9:C\n10:[\"$\",\"section\",\"Non-commercial status\",{\"className\":\"py-7 sm:grid sm:grid-cols-3 sm:gap-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-semibold text-ink sm:col-span-1\",\"children\":\"Non-commercial status\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 leading-7 text-ink-muted sm:col-span-2 sm:mt-0\",\"children\":\"No commercial activity is conducted through this site. There is no checkout, no ordering, no price list, no subscription, no licensing, and no transaction of any kind. Nothing published here constitutes an offer, a quotation, an invitation to contract, or a commitment to supply software or services, and no binding agreement can be concluded through this page. The prototypes are not made available for operational use.\"}]]}]\n11:[\"$\",\"section\",\"Why we publish it\",{\"className\":\"py-7 sm:grid sm:grid-cols-3 sm:gap-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-semibold text-ink sm:col-span-1\",\"children\":\"Why we publish it\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 leading-7 text-ink-muted sm:col-span-2 sm:mt-0\",\"children\":\"Research of this kind is only useful if practitioners review it. The initiative is published so that shipowners, fleet managers, DPAs, quality managers, HSE officers, masters, auditors, and academic researchers can examine the approach and tell us where it does not match practice. Their input shapes the direction of the research.\"}]]}]\n12:[\"$\",\"section\",\"How to take part\",{\"className\":\"py-7 sm:grid sm:grid-cols-3 sm:gap-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-semibold text-ink sm:col-span-1\",\"children\":\"How to take part\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 leading-7 text-ink-muted sm:col-span-2 sm:mt-0\",\"children\":\"Participation is by correspondence only. Write to info@maridots.com to arrange a technical discussion or to contribute a practitioner or academic perspective. Discussions are conducted directly between people on the international team, free of charge, with no commitment on either side and no commercial follow-up.\"}]]}]\n13:[\"$\",\"section\",\"Illustrative data\",{\"className\":\"py-7 sm:grid sm:grid-cols-3 sm:gap-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-semibold text-ink sm:col-span-1\",\"children\":\"Illustrative data\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 leading-7 text-ink-muted sm:col-span-2 sm:mt-0\",\"children\":\"All dashboards, KPI figures, analytics, and records shown on this site use illustrative research data and are labelled as such. They do not represent any vessel, fleet, organisation, crew member, or audit outcome, and no operational data from any third party is published here.\"}]]}]\n14:[\"$\",\"section\",\"Feedback and confidentiality\",{\"className\":\"py-7 sm:grid sm:grid-cols-3 sm:gap-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-semibold text-ink sm:col-span-1\",\"children\":\"Feedback and confidentiality\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 leading-7 text-ink-muted sm:col-span-2 sm:mt-0\",\"children\":\"Feedback offered during a discussion informs the direction of the research. Information you choose to share is used only for that discussion, is handled by the international team, is not passed to third parties, and is deleted on request.\"}]]}]\n15:[\"$\",\"section\",\"Intellectual property\",{\"className\":\"py-7 sm:grid sm:grid-cols-3 sm:gap-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-semibold text-ink sm:col-span-1\",\"children\":\"Intellectual property\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 leading-7 text-ink-muted sm:col-span-2 sm:mt-0\",\"children\":\"The prototypes, content, design, and materials published on this site remain the property of the initiative and its contributors. Reproduction, adaptation, or redistribution beyond personal review requires prior written consent.\"}]]}]\n16:[\"$\",\"section\",\"Accuracy and liability\",{\"className\":\"py-7 sm:grid sm:grid-cols-3 sm:gap-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-semibold text-ink sm:col-span-1\",\"children\":\"Accuracy and liability\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 leading-7 text-ink-muted sm:col-span-2 sm:mt-0\",\"children\":\"This is research material. Prototypes, interfaces, and descriptions change without notice, no warranty is given as to accuracy, completeness, or timeliness, and nothing published here should be relied upon for any operational, regulatory, or compliance decision. This site links to external resources over whose content the initiative has no control and for which no responsibility is accepted.\"}]]}]\n17:[\"$\",\"section\",\"Contact\",{\"className\":\"py-7 sm:grid sm:grid-cols-3 sm:gap-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-semibold text-ink sm:col-span-1\",\"children\":\"Contact\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 leading-7 text-ink-muted sm:col-span-2 sm:mt-0\",\"children\":\"Questions about this notice or the research are handled by the international team: info@maridots.com · https://maridots.com\"}]]}]\n18:[\"$\",\"$L1e\",null,{\"children\":[\"$\",\"$1c\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@1f\"}]}]\n1a:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":